VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required before public indexing/deployment. Leave empty during development.
VITE_SITE_URL=
# VITE_SITE_URL also controls email confirmations/reset destinations.
# Must be a reachable HTTPS origin, with /auth/callback allowed in Supabase Auth.
# Localhost links work only on the computer running the development server.
