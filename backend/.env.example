SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only secret key is required for trusted persistence of validated AI results.
SUPABASE_SECRET_KEY=
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_UPLOAD_BYTES=10485760
ENVIRONMENT=development
# Public operator details; never invent these values.
PUBLIC_SITE_URL=
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
LEGAL_NOTICES_APPROVED=false
# Public site key only. Configure Turnstile verification secret in Supabase Auth CAPTCHA settings.
TURNSTILE_SITE_KEY=
# Optional analytics requires server-only Supabase key and explicit visitor consent.
ANALYTICS_ENABLED=false
